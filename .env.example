# Copy this file to .env (never commit .env). A blank key disables that capability;
# the agent will say which capability is unavailable and continue with the rest.

# --- Text-to-speech (voiceover). ElevenLabs preferred, OpenAI TTS fallback. ---
TTS_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Generative visuals (approval-gated). Set only the ones you use. ---
IMAGE_GEN_API_KEY=      # Flux / Ideogram / DALL-E
VIDEO_GEN_API_KEY=      # Runway / Kling / Veo

# --- Stock (fallback B-roll and stills; licence + attribution logged). ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
